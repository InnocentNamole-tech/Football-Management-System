@model List<SquadPlayerRow>
@{
    var match = ViewBag.Match as MatchRow;
    var canManageSquad = ViewBag.CanManageSquad is true;
    ViewData["Title"] = "Squad";
    ViewData["Description"] = "The named matchday squad, starters and substitutes.";
    ViewData["Crumb"] = "Squads";
    ViewData["CrumbUrl"] = Url.Action("Index");
    if (canManageSquad && match is not null)
    {
        ViewData["PrimaryText"] = "Edit squad";
        ViewData["PrimaryUrl"] = Url.Action("Edit", new { id = match.MatchId });
    }
    var starters = Model.Where(p => p.IsStarting).ToList();
    var bench = Model.Where(p => !p.IsStarting).ToList();
}
<partial name="_PageHeader" />

@if (match is not null)
{
    <div class="card stage-band">
        <div>
            <strong>@match.Opponent</strong>
            <span>@match.MatchDate.ToString("dd MMM yyyy")</span>
            @if (match.CompetitionName is not null)
            {
                <span class="pill pill-muted">@match.CompetitionName</span>
            }
        </div>
        <p>@(string.IsNullOrWhiteSpace(match.Formation) ? "No formation" : match.Formation) · @starters.Count starters · @bench.Count substitutes</p>
    </div>
}

@if (Model.Count == 0)
{
    <div class="card empty">
        <p>No squad has been named for this match.</p>
        @if (canManageSquad && match is not null)
        {
            <p>Pick the eleven and the bench to lock it in.</p>
            <a class="btn btn-primary" asp-action="Edit" asp-route-id="@match.MatchId">Select squad</a>
        }
        else
        {
            <p>The coach has not selected a squad for this match yet.</p>
        }
    </div>
}
else
{
    <div class="grid grid-2">
        <section class="card">
            <h2 class="section-title">Starting eleven</h2>
            <div class="table-wrap">
                <table class="data">
                    <thead>
                        <tr>
                            <th>#</th>
                            <th>Player</th>
                            <th>Position</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var player in starters)
                        {
                            <tr>
                                <td>@player.JerseyNumber</td>
                                <td><strong>@player.FullName</strong></td>
                                <td>@player.PositionName</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </section>

        <section class="card">
            <h2 class="section-title">Bench</h2>
            @if (bench.Count == 0)
            {
                <p class="help">No substitutes named for this match.</p>
            }
            else
            {
                <div class="table-wrap">
                    <table class="data">
                        <thead>
                            <tr>
                                <th>#</th>
                                <th>Player</th>
                                <th>Position</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var player in bench)
                            {
                                <tr>
                                    <td>@player.JerseyNumber</td>
                                    <td><strong>@player.FullName</strong></td>
                                    <td>@player.PositionName</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </section>
    </div>
}
