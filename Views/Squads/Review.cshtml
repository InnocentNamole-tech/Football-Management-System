@model SquadReviewVm
@{
    ViewData["Title"] = "Review the squad";
    ViewData["Description"] = "Step 4 of 4 — check the eleven and the bench before saving.";
    ViewData["Crumb"] = "Squads";
    ViewData["CrumbUrl"] = Url.Action("Index");
}
<partial name="_PageHeader" />

<ol class="stepper" aria-label="Squad selection progress">
    <li class="done">Match &amp; formation</li>
    <li class="done">Starting eleven</li>
    <li class="done">Bench</li>
    <li class="current">Review</li>
</ol>

<div class="card stage-band">
    <div>
        <span class="pill pill-muted">@Model.Formation</span>
        <strong>@Model.MatchLabel</strong>
    </div>
    <p>@Model.Starters.Count starters · @Model.Bench.Count on the bench</p>
</div>

<div class="grid grid-2">
    <section class="card">
        <h2 class="section-title">Starting eleven</h2>
        @if (Model.Starters.Count == 0)
        {
            <p class="help">No starters selected.</p>
        }
        else
        {
            <ul class="check-list">
                @foreach (var player in Model.Starters)
                {
                    <li>
                        <span class="num">@player.JerseyNumber</span>
                        <span class="who">
                            <strong>@player.FullName</strong>
                            <small>@player.PositionName</small>
                        </span>
                    </li>
                }
            </ul>
        }
    </section>

    <section class="card">
        <h2 class="section-title">Bench</h2>
        @if (Model.Bench.Count == 0)
        {
            <p class="help">No substitutes selected.</p>
        }
        else
        {
            <ul class="check-list">
                @foreach (var player in Model.Bench)
                {
                    <li>
                        <span class="num">@player.JerseyNumber</span>
                        <span class="who">
                            <strong>@player.FullName</strong>
                            <small>@player.PositionName</small>
                        </span>
                    </li>
                }
            </ul>
        }
    </section>
</div>

<form asp-action="Confirm" method="post" class="form-actions">
    <button type="submit" class="btn btn-primary">Save squad</button>
    <a class="btn btn-ghost" asp-action="Step3">Back to bench</a>
    <a class="btn btn-ghost" asp-action="Index">Cancel</a>
</form>
