@model TeamHistoryVm
@{
    var clubName = ViewBag.ClubName as string ?? "your club";
    ViewData["Title"] = "Edit club history";
    ViewData["Description"] = $"Update a milestone in the story of {clubName}.";
    ViewData["Crumb"] = "Team history";
    ViewData["CrumbUrl"] = Url.Action("Index");
}
<partial name="_PageHeader" />

<form asp-action="Edit" method="post" class="form-card">
    <input type="hidden" asp-for="HistoryId" />
    <div asp-validation-summary="ModelOnly" class="alert alert-error"></div>

    <div class="form-grid">
        <div class="form-group span-2">
            <label asp-for="Title"></label>
            <input asp-for="Title" class="input" maxlength="120" />
            <span asp-validation-for="Title" class="field-error"></span>
        </div>

        <div class="form-group">
            <label asp-for="Year"></label>
            <input asp-for="Year" class="input" type="number" min="1850" max="2100" />
            <span asp-validation-for="Year" class="field-error"></span>
        </div>

        <div class="form-group span-2">
            <label asp-for="Description"></label>
            <textarea asp-for="Description" class="input" rows="6" maxlength="1000"></textarea>
            <span asp-validation-for="Description" class="field-error"></span>
        </div>
    </div>

    <div class="form-actions">
        <button type="submit" class="btn btn-primary">Save changes</button>
        <a class="btn btn-ghost" asp-action="Index">Cancel</a>
    </div>
</form>
