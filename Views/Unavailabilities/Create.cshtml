@model UnavailabilityVm
@{
    ViewData["Title"] = "Add unavailability";
    ViewData["Description"] = "Tell the club which dates you cannot train or play.";
    ViewData["Crumb"] = "My unavailability";
    ViewData["CrumbUrl"] = Url.Action("Index", "Unavailabilities");
}

<partial name="_PageHeader" />

<div class="card form-card">
    <form asp-controller="Unavailabilities" asp-action="Create" method="post">
        <div asp-validation-summary="ModelOnly" class="alert alert-error" role="alert"></div>

        <div class="form-grid">
            <div class="form-group">
                <label asp-for="StartDate">Start date <span class="req">*</span></label>
                <input asp-for="StartDate" class="input" type="date" />
                <span asp-validation-for="StartDate" class="field-error"></span>
            </div>

            <div class="form-group">
                <label asp-for="EndDate">End date <span class="req">*</span></label>
                <input asp-for="EndDate" class="input" type="date" />
                <span class="help">The end date cannot be before the start date.</span>
                <span asp-validation-for="EndDate" class="field-error"></span>
            </div>

            <div class="form-group span-2">
                <label asp-for="Reason">Reason <span class="req">*</span></label>
                <textarea asp-for="Reason" class="input" rows="4" placeholder="e.g. Family commitment, exam week, minor injury"></textarea>
                <span asp-validation-for="Reason" class="field-error"></span>
            </div>
        </div>

        <div class="form-actions">
            <button type="submit" class="btn btn-primary">Add unavailability</button>
            <a class="btn btn-secondary" asp-controller="Unavailabilities" asp-action="Index">Cancel</a>
        </div>
    </form>
</div>
