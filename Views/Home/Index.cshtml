@{
    ViewData["Title"] = "Welcome";
    ViewData["Description"] = "Fixtures, squads, statistics and competitions for Your Local football clubs.";
}

<section class="landing-hero">
    <div class="landing-hero-copy fade-up">
        <span class="eyebrow">University football, one platform</span>
        <h1>Run the club.<br />Follow the season.</h1>
        <p class="landing-lede">
            From the first whistle to the final table — squads, fixtures, results, player numbers
            and competition entries, all in one place for every role at the club.
        </p>
        <div class="landing-actions">
            <a class="btn btn-primary btn-large" asp-controller="Account" asp-action="Login">Sign in</a>
            <a class="btn btn-gold btn-large" asp-controller="Account" asp-action="Register">Create an account</a>
        </div>
        <ul class="landing-chips" aria-label="Clubs on the platform">
            <li>WSU BCC</li>
            <li>WSU Dream Team</li>
            <li>Juniors FC</li>
        </ul>
    </div>

    <div class="landing-visual fade-up" aria-hidden="true">
        <div class="pitch-card">
            <div class="pitch">
                <span class="pitch-line pitch-halfway"></span>
                <span class="pitch-circle"></span>
                <span class="pitch-box pitch-box-top"></span>
                <span class="pitch-box pitch-box-bottom"></span>
                <span class="pitch-goal pitch-goal-top"></span>
                <span class="pitch-goal pitch-goal-bottom"></span>
                <svg class="pitch-ball" viewBox="0 0 64 64" role="presentation">
                    <circle cx="32" cy="32" r="28" fill="#f7f4ea" stroke="#123c28" stroke-width="3" />
                    <path d="M32 16l11 8-4 13H25l-4-13 11-8z" fill="#123c28" />
                    <path d="M32 4v12M53 22l-10 2M48 51l-9-14M16 51l9-14M11 22l10 2" stroke="#123c28" stroke-width="3" fill="none" />
                </svg>
            </div>
            <div class="pitch-caption">
                <span class="pill pill-gold">Matchday</span>
                <strong>WSU BCC</strong>
                <span class="pitch-vs">vs</span>
                <strong>East London Rovers</strong>
            </div>
        </div>
    </div>
</section>

<section class="landing-section" aria-labelledby="join-heading">
    <div class="section-heading">
        <span class="eyebrow">Join the platform</span>
        <h2 id="join-heading">Two ways in, no administrator needed</h2>
        <p>Fans and competition organisers can create their own account. Club staff accounts are issued by the system administrator or club coordinator.</p>
    </div>

    <div class="landing-cards">
        <article class="landing-card">
            <span class="landing-icon">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2" />
                    <circle cx="9" cy="7" r="4" />
                    <path d="M23 21v-2a4 4 0 0 0-3-3.87M16 3.13a4 4 0 0 1 0 7.75" />
                </svg>
            </span>
            <h3>Club fan</h3>
            <p>Follow your club, see fixtures and results, read announcements and join the matchday conversation.</p>
            <a class="btn btn-primary btn-small" asp-controller="Account" asp-action="RegisterFan">Create a fan account</a>
        </article>

        <article class="landing-card">
            <span class="landing-icon">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <path d="M8 21h8M12 17v4M7 4h10v5a5 5 0 0 1-10 0V4z" />
                    <path d="M17 5h3v2a3 3 0 0 1-3 3M7 5H4v2a3 3 0 0 0 3 3" />
                </svg>
            </span>
            <h3>Competition organiser</h3>
            <p>Create competitions, review club entry requests and record the outcomes at the end of the season.</p>
            <a class="btn btn-gold btn-small" asp-controller="Account" asp-action="RegisterOrganiser">Create an organiser account</a>
        </article>

        <article class="landing-card">
            <span class="landing-icon">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <path d="M12 3a9 9 0 1 0 0 18 9 9 0 0 0 0-18z" />
                    <path d="M12 7l3 2-1 3.5h-4L9 9l3-2z" />
                    <path d="M12 7V3M15 9l4-1M14 12.5l2.5 3M10 12.5L7.5 15.5M9 9L5 8" />
                </svg>
            </span>
            <h3>Club staff</h3>
            <p>Coordinators, coaches and players sign in with the account issued by their club or the system administrator.</p>
            <a class="btn btn-secondary btn-small" asp-controller="Account" asp-action="Login">Sign in</a>
        </article>
    </div>
</section>

<section class="landing-features" aria-labelledby="features-heading">
    <div class="section-heading">
        <span class="eyebrow">Everything matchday</span>
        <h2 id="features-heading">Built around the way a club runs</h2>
    </div>
    <div class="feature-grid">
        <div class="feature">
            <h3>Fixtures &amp; results</h3>
            <p>Upcoming matches, scorelines and form in one timeline.</p>
        </div>
        <div class="feature">
            <h3>Squad selection</h3>
            <p>Coaches name eleven starters and up to eight substitutes, with formation.</p>
        </div>
        <div class="feature">
            <h3>Player numbers</h3>
            <p>Goals, assists, minutes, cards and leaderboards across the season.</p>
        </div>
        <div class="feature">
            <h3>Competitions</h3>
            <p>Entry requests, approvals and outcomes from group stage to the final.</p>
        </div>
    </div>
</section>
