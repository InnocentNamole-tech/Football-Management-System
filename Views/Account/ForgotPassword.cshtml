@model ForgotPasswordVm
@{
    ViewData["Title"] = "Forgot password";
    ViewData["Description"] = "Confirm your email address and username to choose a new password.";
}

<div class="auth-page auth-page-center fade-up">
    <div class="card auth-card">
        <span class="eyebrow">Account recovery</span>
        <h1>Forgot password</h1>
        <p class="muted small">Enter the email address and username on your account. If they match, you can choose a new password.</p>

        <form asp-controller="Account" asp-action="ForgotPassword" method="post">
            <div asp-validation-summary="ModelOnly" class="alert alert-error" role="alert"></div>

            <div class="form-group mb-1">
                <label asp-for="Email">Email <span class="req">*</span></label>
                <input asp-for="Email" class="input" type="email" autocomplete="email" />
                <span asp-validation-for="Email" class="field-error"></span>
            </div>

            <div class="form-group">
                <label asp-for="Username">Username <span class="req">*</span></label>
                <input asp-for="Username" class="input" autocomplete="username" />
                <span asp-validation-for="Username" class="field-error"></span>
            </div>

            <div class="form-actions">
                <button type="submit" class="btn btn-primary btn-block">Confirm details</button>
            </div>
        </form>

        <div class="auth-links">
            <a asp-controller="Account" asp-action="Login">Back to sign in</a>
        </div>
    </div>
</div>
