@model SelfResetPasswordVm
@{
    ViewData["Title"] = "Choose a new password";
    ViewData["Description"] = "Set a new password for your account, then return to sign in.";
}

<div class="auth-page auth-page-center fade-up">
    <div class="card auth-card">
        <span class="eyebrow">Account recovery</span>
        <h1>Choose a new password</h1>
        <p class="muted small">Your details matched. Set a new password below, then return to sign in.</p>

        <form asp-controller="Account" asp-action="ResetPassword" method="post">
            <div asp-validation-summary="ModelOnly" class="alert alert-error" role="alert"></div>

            <div class="form-group mb-1">
                <label asp-for="NewPassword">New password <span class="req">*</span></label>
                <input asp-for="NewPassword" class="input" autocomplete="new-password" />
                <span class="help">At least 8 characters with upper case, lower case, a digit and a special character.</span>
                <span asp-validation-for="NewPassword" class="field-error"></span>
            </div>

            <div class="form-group">
                <label asp-for="ConfirmPassword">Confirm new password <span class="req">*</span></label>
                <input asp-for="ConfirmPassword" class="input" autocomplete="new-password" />
                <span asp-validation-for="ConfirmPassword" class="field-error"></span>
            </div>

            <div class="form-actions">
                <button type="submit" class="btn btn-primary btn-block">Update password</button>
            </div>
        </form>

        <div class="auth-links">
            <a asp-controller="Account" asp-action="Login">Back to sign in</a>
        </div>
    </div>
</div>
