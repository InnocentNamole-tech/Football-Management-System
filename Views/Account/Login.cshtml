@model LoginVm
@{
    ViewData["Title"] = "Sign in";
    ViewData["Description"] = "Sign in to manage your club, follow fixtures and keep the season moving.";
}

<div class="auth-page auth-page-center fade-up">
    <div class="card auth-card">
        <span class="eyebrow">Welcome back</span>
        <h1>Sign in</h1>
        <p class="muted small">Use the username and password issued to you by your club or the system administrator.</p>

        <form asp-controller="Account" asp-action="Login" method="post" novalidate="novalidate">
            <div asp-validation-summary="ModelOnly" class="alert alert-error" role="alert"></div>

            <div class="form-group mb-1">
                <label asp-for="Username">Username <span class="req">*</span></label>
                <input asp-for="Username" class="input" autocomplete="username" autofocus="autofocus" />
                <span asp-validation-for="Username" class="field-error"></span>
            </div>

            <div class="form-group">
                <label asp-for="Password">Password <span class="req">*</span></label>
                <input asp-for="Password" class="input" autocomplete="current-password" />
                <span asp-validation-for="Password" class="field-error"></span>
            </div>

            <input type="hidden" asp-for="ReturnUrl" />

            <div class="form-actions">
                <button type="submit" class="btn btn-primary btn-block">Sign in</button>
            </div>
        </form>

        <div class="auth-links">
            <a asp-controller="Account" asp-action="ForgotPassword">Forgot password?</a>
        </div>

        <div class="divider"></div>

        <p class="small muted mb-0">
            New here? <a asp-controller="Account" asp-action="Register">Create a fan or organiser account</a>.
        </p>
        <p class="small muted mt-1 mb-0">Five failed attempts lock the account for five minutes. Ask an administrator to unlock it sooner.</p>
    </div>
</div>
