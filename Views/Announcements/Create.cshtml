@model AnnouncementVm
@{
    ViewData["Title"] = "Post announcement";
    ViewData["Description"] = "Publish a short notice to everyone in your club.";
    ViewData["Crumb"] = "Announcements";
    ViewData["CrumbUrl"] = Url.Action("Index");
}
<partial name="_PageHeader" />

<form asp-action="Create" method="post" class="form-card">
    <div asp-validation-summary="ModelOnly" class="alert alert-error"></div>

    <div class="form-grid">
        <div class="form-group span-2">
            <label asp-for="Title"></label>
            <input asp-for="Title" class="input" maxlength="120" />
            <span asp-validation-for="Title" class="field-error"></span>
        </div>

        <div class="form-group span-2">
            <label asp-for="Description"></label>
            <textarea asp-for="Description" class="input" rows="6" maxlength="1000"></textarea>
            <span asp-validation-for="Description" class="field-error"></span>
            <span class="help">Up to 1000 characters. Keep it clear and short.</span>
        </div>
    </div>

    <div class="form-actions">
        <button type="submit" class="btn btn-primary">Post announcement</button>
        <a class="btn btn-ghost" asp-action="Index">Cancel</a>
    </div>
</form>
