@model List<AnnouncementRow>
@{
    var canPost = ViewBag.CanPost is true;
    var ownCoordinatorId = ViewBag.OwnCoordinatorId as int?;
    ViewData["Title"] = "Announcements";
    ViewData["Description"] = "Club notices, reminders and matchday news in one feed.";
    if (canPost)
    {
        ViewData["PrimaryText"] = "Post announcement";
        ViewData["PrimaryUrl"] = Url.Action("Create");
    }
}
<partial name="_PageHeader" />

@if (Model.Count == 0)
{
    <div class="card empty">
        <p>No announcements have been posted yet.</p>
        @if (canPost)
        {
            <p>Keep the club informed with the first notice.</p>
            <a class="btn btn-primary" asp-action="Create">Post announcement</a>
        }
        else
        {
            <p>Check back soon for club news.</p>
        }
    </div>
}
else
{
    <div class="grid grid-2">
        @foreach (var item in Model)
        {
            <article class="card announcement">
                <header>
                    <h3>@item.Title</h3>
                    <span class="pill pill-muted">@item.DatePosted.ToString("dd MMM yyyy")</span>
                </header>
                <p>@item.Description</p>
                <footer>
                    <span>@item.AuthorName</span>
                    @if (canPost)
                    {
                        <span class="btn-row">
                            <a class="btn btn-small btn-ghost" asp-action="Edit" asp-route-id="@item.AnnouncementId">Edit</a>
                            @if (ownCoordinatorId == item.CoordinatorId)
                            {
                                <a class="btn btn-small btn-danger" asp-action="Delete" asp-route-id="@item.AnnouncementId">Delete</a>
                            }
                        </span>
                    }
                </footer>
            </article>
        }
    </div>
}
