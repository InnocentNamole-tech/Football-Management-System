@model AnnouncementVm
@{
    ViewData["Title"] = "Edit announcement";
    ViewData["Description"] = "Update the wording of a notice already posted.";
    ViewData["Crumb"] = "Announcements";
    ViewData["CrumbUrl"] = Url.Action("Index");
}
<partial name="_PageHeader" />

<form asp-action="Edit" method="post" class="form-card">
    <input type="hidden" asp-for="AnnouncementId" />
    <div asp-validation-summary="ModelOnly" class="alert alert-error"></div>

    <div class="form-grid">
        <div class="form-group span-2">
            <label asp-for="Title"></label>
            <input asp-for="Title" class="input" maxlength="120" />
            <span asp-validation-for="Title" class="field-error"></span>
        </div>

        <div class="form-group span-2">
            <label asp-for="Description"></label>
            <textarea asp-for="Description" class="input" rows="6" maxlength="1000"></textarea>
            <span asp-validation-for="Description" class="field-error"></span>
        </div>
    </div>

    <div class="form-actions">
        <button type="submit" class="btn btn-primary">Save changes</button>
        <a class="btn btn-ghost" asp-action="Index">Cancel</a>
    </div>
</form>
