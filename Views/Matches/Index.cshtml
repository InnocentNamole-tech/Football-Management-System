@model List<MatchRow>
@{
    var clubName = ViewBag.ClubName as string;
    ViewData["Title"] = "Matches";
    ViewData["Description"] = string.IsNullOrWhiteSpace(clubName)
        ? "Every fixture and result recorded for your club."
        : $"Every fixture and result recorded for {clubName}.";
    ViewData["PrimaryText"] = "Create match";
    ViewData["PrimaryUrl"] = Url.Action("Create", "Matches") ?? "/Matches/Create";
}

<partial name="_PageHeader" />

@if (Model.Count == 0)
{
    <div class="empty">
        <h3>No matches scheduled</h3>
        <p>Create a fixture to start building the season. Results and squads hang off each match.</p>
        <a class="btn btn-primary btn-small" asp-controller="Matches" asp-action="Create">Create match</a>
    </div>
}
else
{
    <div class="table-wrap">
        <table class="data">
            <thead>
            <tr>
                <th>Date</th>
                <th>Opponent</th>
                <th>Competition</th>
                <th>Venue</th>
                <th>Result</th>
                <th>Squad</th>
                <th>Actions</th>
            </tr>
            </thead>
            <tbody>
            @foreach (var match in Model)
            {
                <tr>
                    <td class="nowrap">@match.MatchDate.ToString("dd MMM yyyy")<br /><small>@match.KickoffTime.ToString(@"hh\:mm")</small></td>
                    <td><strong>@match.Opponent</strong></td>
                    <td>@(string.IsNullOrWhiteSpace(match.CompetitionName) ? "Friendly" : match.CompetitionName)</td>
                    <td>@match.StadiumName</td>
                    <td>
                        @if (match.Result is null)
                        {
                            <span class="pill pill-neutral">Awaiting result</span>
                        }
                        else
                        {
                            <span class="scoreline">@match.Scoreline</span>
                            <span class="result @(match.Result == "Win" ? "result-win" : match.Result == "Loss" ? "result-loss" : "result-draw")">@match.Result</span>
                        }
                    </td>
                    <td>
                        @if (match.HasSquad)
                        {
                            <span class="pill pill-active">Selected</span>
                        }
                        else
                        {
                            <span class="pill pill-pending">Not selected</span>
                        }
                    </td>
                    <td>
                        <div class="actions">
                            <a class="btn btn-secondary btn-small" asp-controller="Matches" asp-action="Details" asp-route-id="@match.MatchId">View</a>
                            @if (match.HasSquad)
                            {
                                <a class="btn btn-secondary btn-small" asp-controller="Squads" asp-action="Details" asp-route-id="@match.MatchId">View squad</a>
                            }
                            <a class="btn btn-secondary btn-small" asp-controller="Matches" asp-action="EditResult" asp-route-id="@match.MatchId">Edit result</a>
                            <a class="btn btn-secondary btn-small" asp-controller="Statistics" asp-action="Add" asp-route-matchId="@match.MatchId">Add stats</a>
                        </div>
                    </td>
                </tr>
            }
            </tbody>
        </table>
    </div>
    <p class="table-note">@Model.Count match@(Model.Count == 1 ? "" : "es") on record.</p>
}
