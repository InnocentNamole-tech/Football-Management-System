@model ResetPasswordVm
@{
    ViewData["Title"] = "Reset password";
    ViewData["Description"] = "Set a new password for this account. The old password stops working immediately.";
    ViewData["Crumb"] = "Accounts";
    ViewData["CrumbUrl"] = Url.Action("Accounts", "Admin");
}

<partial name="_PageHeader" />

<div class="card form-card">
    <p class="notice mb-1">Resetting the password for <strong>@Model.PersonName</strong>. This also clears any lockout.</p>

    <form asp-controller="Admin" asp-action="ResetPassword" method="post">
        <input type="hidden" asp-for="PersonId" />
        <input type="hidden" asp-for="PersonName" />

        <div asp-validation-summary="ModelOnly" class="alert alert-error" role="alert"></div>

        <div class="form-grid">
            <div class="form-group">
                <label asp-for="NewPassword">New password <span class="req">*</span></label>
                <input asp-for="NewPassword" class="input" autocomplete="new-password" />
                <span class="help">Minimum 8 characters with upper case, lower case, a digit and a special character.</span>
                <span asp-validation-for="NewPassword" class="field-error"></span>
            </div>
            <div class="form-group">
                <label asp-for="ConfirmPassword">Confirm new password <span class="req">*</span></label>
                <input asp-for="ConfirmPassword" class="input" autocomplete="new-password" />
                <span asp-validation-for="ConfirmPassword" class="field-error"></span>
            </div>
        </div>

        <div class="form-actions">
            <button type="submit" class="btn btn-primary">Reset password</button>
            <a class="btn btn-secondary" asp-controller="Admin" asp-action="Accounts">Cancel</a>
        </div>
    </form>
</div>
